{
  "name": "nexus-canvas-chat",
  "version": "1.0.0",
  "private": true,
  "description": "Nexus Canvas — a Supabase-backed chat room, with pictures stored in Cloudflare R2 through Vercel functions",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.cjs",
    "migrate-images": "node --env-file=.env.local scripts/migrate-images-to-r2.mjs",
    "sweep-r2": "node --env-file=.env.local scripts/sweep-r2.mjs"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20"
  }
}
